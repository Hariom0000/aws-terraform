# Terraform working directory
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files that may contain secrets
*.tfvars
!terraform.tfvars.example

# Terraform plan files
*.tfplan
*.tfplan.json

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
